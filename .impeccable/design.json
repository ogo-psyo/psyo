      "css": ".ds-primary{font-family:Arial,sans-serif;font-weight:400;line-height:1.5;cursor:pointer;border:0;background:none;}.ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:9px;min-height:48px;padding:12px 19px;border-radius:22px;background:linear-gradient(130deg,#fff 0%,#e8e0f29e 68%,#e6edf67a);border:1px solid #fff;box-shadow:inset 0 1px white,inset 0 -1px #b6a8cc2d,0 5px 15px #6d557716;color:#50445f;font-size:14px;}.ds-primary:focus-visible{outline:2px solid #786b94;outline-offset:3px}.ds-primary:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:transform .15s,background-color .15s}.ds-primary:active{transform:scale(.96)}}",
