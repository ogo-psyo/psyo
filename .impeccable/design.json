    {
      "name": "Navigation tray",
      "kind": "nav",
      "description": "Five source destinations with current-page semantics.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><a class=\"ds-nav-item ds-active\" href=\"#home\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z\"/><path d=\"M9 20v-7h6v7\"/></svg>Псё</a><a class=\"ds-nav-item\" href=\"#map\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2Z\"/><path d=\"M9 3v16M15 5v16\"/></svg>Карта</a><a class=\"ds-nav-item\" href=\"#gav\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 11a8 8 0 0 1-8 8H5l-3 3V11a9 9 0 0 1 18 0Z\"/><path d=\"M7 11h0m5 0h0m5 0h0\"/></svg>Гав</a><a class=\"ds-nav-item\" href=\"#all\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/></svg>Всё</a><a class=\"ds-nav-item\" href=\"#profile\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"7\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>Профиль</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-around;padding:5px;border:1px solid white;border-radius:26px;background:linear-gradient(130deg,#ffffffc9,#ffffff75);box-shadow:inset 0 1px white,0 6px 22px #78668b17;backdrop-filter:blur(23px);}.ds-nav-item{display:grid;gap:5px;justify-items:center;padding:8px 6px;min-width:51px;color:#82768e;font-size:10px;border-radius:18px;}.ds-nav-item.ds-active{background:#e9e4ef9c;color:#584866;}.ds-nav-item{font:10px/1.5 Arial,sans-serif;text-decoration:none;} .ds-nav-item svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-nav-item svg{width:20px;height:20px}.ds-nav-item:focus-visible{outline:2px solid #786b94;outline-offset:3px}",
