      "css": ".ds-list-row{font-family:Arial,sans-serif;font-weight:400;line-height:1.5;cursor:pointer;border:0;background:none;color:#3e3947;}.ds-list-row{display:flex;align-items:center;gap:13px;text-align:left;min-height:73px;padding:14px 2px;width:100%;border-bottom:1px solid #dad4e143;}.ds-list-row .ds-grow{flex:1;min-width:0;}.ds-list-row strong{display:block;font-size:15px;font-weight:400;overflow-wrap:anywhere;}.ds-list-row small{display:block;font-size:12px;line-height:1.5;color:#817588;margin-top:5px;}.ds-list-row svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-list-row>.ds-icon{width:17px;color:#9a8da4;}.ds-list-row:focus-visible{outline:2px solid #786b94;outline-offset:3px}.ds-list-row:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-list-row{transition:transform .15s,background-color .15s}.ds-list-row:active{transform:scale(.96)}}",
